{
  "name": "leonkrix.dev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/clear-content-cache.mjs && astro dev",
    "build": "node scripts/clear-content-cache.mjs && astro build",
    "preview": "astro preview",
    "lint": "astro sync && eslint .",
    "lint:fix": "astro sync && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && tsc -p functions/tsconfig.json",
    "build:functions": "wrangler pages functions build functions --outfile .wrangler/functions-worker.js --compatibility-date 2026-09-29 --compatibility-flag nodejs_compat",
    "dev:functions": "pnpm build && wrangler pages dev ./dist --port 8788 --kv RATE_LIMIT --compatibility-date 2026-09-29 --compatibility-flag nodejs_compat",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "build:form": "node scripts/build-with-form.mjs",
    "test:e2e": "pnpm build:form && playwright test",
    "lighthouse": "pnpm build:form && node scripts/lighthouse.mjs",
    "og": "node scripts/generate-og.mjs",
    "live-check": "node scripts/live-check.ts",
    "check-links": "node scripts/check-links.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:dist",
    "prepare": "husky",
    "levels": "vitest run --config vitest.levels.config.ts",
    "levels-backbone": "vitest run --config vitest.backbone.config.ts",
    "word-radar-data": "node scripts/word-radar/build-data.ts",
    "word-radar-data-de": "node scripts/word-radar/build-data-de.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "playwright-layout-guard": "0.4.0",
    "playwright-privacy-guard": "0.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "worker-mailer": "^1.3.0"
  }
}
