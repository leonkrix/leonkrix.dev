{
  // Cloudflare Pages Functions run in the Workers runtime, not in a browser or Node.
  // They get their own TypeScript configuration with the Workers types (these conflict with the
  // DOM types that the Astro project uses), so this folder is excluded from the root tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts"]
}
