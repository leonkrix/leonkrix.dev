---
import ExternalLink from '@/components/ExternalLink.astro';
import ProtectedEmail from '@/components/ProtectedEmail.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/lib/site';
---

<BaseLayout>
  <main id="main" class="flex-1">
    <div class="mx-auto flex min-h-[calc(100dvh-4rem)] max-w-5xl flex-col justify-center gap-6 px-6">
      <p class="font-mono text-sm text-accent-2">Hello, I'm</p>
      <h1 class="text-5xl font-semibold tracking-tight sm:text-7xl">{siteConfig.name}</h1>
      <p class="text-xl text-muted sm:text-2xl">{siteConfig.role}</p>
      <p class="font-mono text-sm text-muted">Portfolio under construction.</p>
      <nav class="flex gap-6 text-sm" aria-label="Contact">
        <ExternalLink
          class="text-accent underline-offset-4 hover:underline"
          href={siteConfig.github}
        >
          GitHub
        </ExternalLink>
        <ProtectedEmail
          class="text-accent underline-offset-4 hover:underline"
          address={siteConfig.email}
        />
      </nav>
    </div>

    <Section id="about" index="01" title="About">
      <p class="max-w-2xl text-muted">Coming soon.</p>
    </Section>
    <Section id="projects" index="02" title="Projects">
      <p class="max-w-2xl text-muted">Coming soon.</p>
    </Section>
    <Section id="experience" index="03" title="Experience">
      <p class="max-w-2xl text-muted">Coming soon.</p>
    </Section>
    <Section id="contact" index="04" title="Contact">
      <p class="max-w-2xl text-muted">Coming soon.</p>
    </Section>
  </main>
</BaseLayout>
