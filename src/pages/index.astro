---
import { getCollection } from 'astro:content';

import AboutFacts from '@/components/AboutFacts.astro';
import Contact from '@/components/Contact.astro';
import ExperienceEntry from '@/components/ExperienceEntry.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import Playground from '@/components/games/Playground.astro';
import Hero from '@/components/Hero.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Reveal from '@/components/Reveal.astro';
import Section from '@/components/Section.astro';
import TechList from '@/components/TechList.astro';
import { liveGames } from '@/games/registry';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { experienceGroups, sortExperience } from '@/lib/experience';
import { formatPeriod, sortProjects } from '@/lib/projects';
import { personJsonLd } from '@/lib/site';
import { technologyGroups } from '@/lib/technologies';
import { buildTimeline } from '@/lib/timeline';

const projects = sortProjects(
  (await getCollection('projects')).map((entry) => ({ id: entry.id, ...entry.data })),
);
const projectTitles = new Map(projects.map((project) => [project.id, project.title]));

const experience = sortExperience((await getCollection('experience')).map((entry) => entry.data));
const timeline = buildTimeline(experience, new Date());

// The Playground section (and its number) exists only while a game is live
const hasPlayground = liveGames().length > 0;
---

<BaseLayout>
  <Reveal />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personJsonLd)} />
  <main id="main" class="flex-1">
    <Hero />

    <Section id="about" index="01" title="About">
      <div class="max-w-2xl space-y-5 text-lg leading-relaxed text-muted">
        <p class="reveal">
          I'm a software engineer who enjoys turning ideas into fast, reliable and well-designed
          software. My work spans the stack and beyond: from low-level code in C and C++ and machine
          learning with Python and PyTorch to full-stack web and mobile applications with
          TypeScript, React, Node.js and Android.
        </p>
        <p class="reveal">
          I care about clean, maintainable code, sensible tooling and the details that make software
          pleasant to use: accessibility, performance and privacy included. This website is a small
          example. It is static, loads no third-party scripts or fonts, even its contact form needs
          no third-party service, and every change passes automated checks before it goes live. My
          IDEs of choice are PyCharm, WebStorm and CLion.
        </p>
        <p class="reveal">
          Outside of work I like building things for fun. Some games are on their way to this site.
        </p>
      </div>
      <AboutFacts />
      <h3 class="reveal mt-14 font-mono text-sm text-accent-2">Technologies I work with</h3>
      <div class="mt-6 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {technologyGroups.map((group) => (
          <div class="reveal">
            <h4 class="mb-3 text-sm font-medium text-fg">{group.title}</h4>
            <TechList items={group.items} />
          </div>
        ))}
      </div>
    </Section>
    <Section id="projects" index="02" title="Projects">
      <ol class="relative before:absolute before:top-[0.6875rem] before:bottom-0 before:-left-px before:w-px before:bg-border">
        {projects.map((project) => (
          <li
            id={`project-${project.id}`}
            class="reveal relative scroll-mt-24 pb-12 pl-8 last:pb-0 sm:pl-10"
          >
            <span
              aria-hidden="true"
              class="absolute top-1.5 -left-px size-2.5 -translate-x-1/2 rounded-full bg-accent ring-4 ring-bg"
            />
            <p class="font-mono text-sm text-accent-2">{formatPeriod(project)}</p>
            <div class="mt-3">
              <ProjectCard project={project} />
            </div>
          </li>
        ))}
      </ol>
    </Section>
    <Section id="experience" index="03" title="Experience">
      {timeline && <ExperienceTimeline model={timeline} />}
      <div class="space-y-14">
        {experienceGroups.map((group) => (
          <div class="reveal">
            <h3 class="flex items-center gap-2 font-mono text-sm text-accent-2">
              <Icon name={group.icon} class="size-4" />
              {group.title}
            </h3>
            <ul class="mt-6 divide-y divide-border">
              {experience
                .filter((entry) => entry.type === group.type)
                .map((entry) => (
                  <ExperienceEntry
                    entry={entry}
                    icon={group.icon}
                    relatedProjectTitle={
                      entry.relatedProject ? projectTitles.get(entry.relatedProject) : undefined
                    }
                  />
                ))}
            </ul>
          </div>
        ))}
      </div>
    </Section>
    <Playground index="04" />
    <Section id="contact" index={hasPlayground ? '05' : '04'} title="Contact">
      <Contact />
    </Section>
  </main>
</BaseLayout>
