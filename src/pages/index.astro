---
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import TechList from '@/components/TechList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { technologyGroups } from '@/lib/technologies';
---

<BaseLayout>
  <main id="main" class="flex-1">
    <Hero />

    <Section id="about" index="01" title="About">
      <div class="max-w-2xl space-y-5 text-lg leading-relaxed text-muted">
        <p>
          I'm a software engineer who enjoys turning ideas into fast, reliable and well-designed
          software. My work spans the stack and beyond: from low-level code in C and C++ and machine
          learning with Python and PyTorch to full-stack web and mobile applications with
          TypeScript, React, Node.js and Android.
        </p>
        <p>
          I care about clean, maintainable code, sensible tooling and the details that make software
          pleasant to use: accessibility, performance and privacy included. This website is a small
          example. It is static, loads no third-party scripts or fonts, and every change passes
          automated checks before it goes live.
        </p>
        <p>
          Outside of work I like building things for fun. Some games are on their way to this site.
        </p>
      </div>
      <h3 class="mt-14 font-mono text-sm text-accent-2">Technologies I work with</h3>
      <div class="mt-6 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {technologyGroups.map((group) => (
          <div>
            <h4 class="mb-3 text-sm font-medium text-fg">{group.title}</h4>
            <TechList items={group.items} />
          </div>
        ))}
      </div>
    </Section>
    <Section id="projects" index="02" title="Projects">
      <p class="max-w-2xl text-muted">Coming soon.</p>
    </Section>
    <Section id="experience" index="03" title="Experience">
      <p class="max-w-2xl text-muted">Coming soon.</p>
    </Section>
    <Section id="contact" index="04" title="Contact">
      <p class="max-w-2xl text-muted">Coming soon.</p>
    </Section>
  </main>
</BaseLayout>
