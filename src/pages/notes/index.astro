---
import { getCollection } from 'astro:content';

import Icon from '@/components/Icon.astro';
import Reveal from '@/components/Reveal.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatUpdated, noteGroups, notePath, readingMinutes, sortNotes } from '@/lib/notes';
import { siteConfig } from '@/lib/site';

const notes = sortNotes(await getCollection('notes'));
const groups = noteGroups
  .map((group) => ({ ...group, notes: notes.filter((note) => note.data.group === group.id) }))
  .filter((group) => group.notes.length > 0);
---

<BaseLayout
  title={`Behind the scenes | ${siteConfig.name}`}
  description="How things on this site are made: short write-ups of the problems behind the games and the site itself, and how they are solved."
  calm
>
  <Reveal />
  <main id="main" class="flex-1">
    <div class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
      <p class="font-mono text-sm text-accent-2">Notes</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Behind the scenes</h1>
      <p class="mt-3 max-w-2xl text-lg text-muted">
        Short write-ups of how things on this site are made, the site itself and the games. Each one
        picks a problem, such as how a page can be made never to move or how a puzzle can prove that
        it has exactly one solution, and shows how it is solved, with the numbers and the tests that
        back it up. The code is public, every note links to it.
      </p>

      {groups.map((group) => (
        <section aria-labelledby={`notes-${group.id}`} class="mt-12">
          <h2 id={`notes-${group.id}`} class="font-mono text-sm text-accent-2">
            {group.title}
          </h2>
          <ul class="mt-4 grid gap-6 sm:grid-cols-2">
            {group.notes.map((note) => (
              <li class="reveal">
                <a
                  href={notePath(note.id)}
                  class="edge group flex h-full flex-col rounded-xl border border-border bg-surface/50 p-5 transition-colors hover:border-accent/50"
                >
                  <p class="font-mono text-xs text-accent-2">{note.data.tag}</p>
                  <h3 class="mt-2 text-lg font-semibold tracking-tight">{note.data.title}</h3>
                  <p class="mt-2 flex-1 text-muted">{note.data.summary}</p>
                  <p class="mt-4 flex items-center justify-between gap-3 text-sm text-muted">
                    <span>
                      {readingMinutes(note.body ?? '')} min read · updated{' '}
                      {formatUpdated(note.data.updated)}
                    </span>
                    <Icon
                      name="lucide:arrow-right"
                      class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
                    />
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
