---
import type { GetStaticPaths } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

import GameGrid from '@/components/games/GameGrid.astro';
import Reveal from '@/components/Reveal.astro';
import { type GameDefinition, games as allGames, liveGames } from '@/games/registry';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/lib/site';

// One route for the overview (/games/) and every live game (/games/<slug>/). With no live game
// nothing is generated at all: the Playground does not exist on the site yet. In the dev server
// (never in a build) the hidden games get their page too, so they can be played while they are
// built; the overview and the navigation still show live games only.
export const getStaticPaths = (() => {
  const live = liveGames();
  const pages = Object.keys(import.meta.glob('/src/games/*/GamePage.astro'));
  const playable = import.meta.env.DEV
    ? allGames.filter((game) => pages.includes(`/src/games/${game.slug}/GamePage.astro`))
    : live;
  if (live.length === 0 && playable.length === 0) {
    return [];
  }
  return [
    { params: { slug: undefined }, props: { game: undefined } },
    ...playable.map((game) => ({ params: { slug: game.slug }, props: { game } })),
  ];
}) satisfies GetStaticPaths;

interface Props {
  game: GameDefinition | undefined;
}

const { game } = Astro.props;

// By convention every game folder has a GamePage.astro with the game and its texts
const gamePages = import.meta.glob<{ default: AstroComponentFactory }>(
  '/src/games/*/GamePage.astro',
  { eager: true },
);
const GamePage =
  game === undefined ? undefined : gamePages[`/src/games/${game.slug}/GamePage.astro`]?.default;
if (game !== undefined && GamePage === undefined) {
  throw new Error(`The live game "${game.slug}" has no src/games/${game.slug}/GamePage.astro.`);
}
const games = liveGames();
---

{GamePage !== undefined && game !== undefined ? (
  <GamePage game={game} />
) : (
  <BaseLayout
    title={`Playground | ${siteConfig.name}`}
    description="Small games by Leon Krix: tech words, logic puzzles and machine learning, running in your browser."
    calm
  >
    <Reveal />
    <main id="main" class="flex-1">
      <div class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
        <p class="font-mono text-sm text-accent-2">Games</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Playground</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted">
          Small games I built for fun. They run in your browser, load nothing from other servers and
          store nothing on your device.
        </p>
        <div class="mt-10">
          <GameGrid games={games} level="h2" />
        </div>
      </div>
    </main>
  </BaseLayout>
)}
