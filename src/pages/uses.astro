---
import Icon from '@/components/Icon.astro';
import Reveal from '@/components/Reveal.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatMonth } from '@/lib/experience';
import { siteConfig } from '@/lib/site';
import { usesCategories, usesSummary, usesUpdated } from '@/lib/uses';
---

<BaseLayout
  title={`Uses | ${siteConfig.name}`}
  description="The hardware, software and tools I work with: my computers, operating systems, terminal, editors, browsers and AI tools."
  calm
  preloadFonts
>
  <Reveal />
  <main id="main" class="flex-1">
    <div class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
      <p class="hero-in font-mono text-sm text-accent-2 [--i:0]">Uses</p>
      <h1 class="hero-in mt-2 text-3xl font-semibold tracking-tight [--i:1] sm:text-4xl">
        What I work with
      </h1>
      <p class="hero-in mt-3 max-w-2xl text-lg text-muted [--i:2]">
        My computers, the software I use every day and the tools I let help me. It is a short list
        on purpose, and nothing on it is sponsored. The languages and technologies I know are in the{' '}
        <a
          href="/#about"
          class="text-fg underline underline-offset-4 transition-colors hover:text-accent"
        >
          About section
        </a>
        .
      </p>

      <div
        data-radar="My setup in short"
        class="uses-terminal edge hero-in mt-10 overflow-hidden rounded-xl border border-border bg-surface/60 font-mono text-sm [--i:3]"
      >
        <div
          class="flex items-center gap-2 border-b border-border px-4 py-3 text-xs text-muted"
          aria-hidden="true"
        >
          <span class="uses-dot"></span>
          <span class="uses-dot"></span>
          <span class="uses-dot"></span>
          <span class="ml-2">leon@leonkrix.dev</span>
        </div>

        <div class="p-5 sm:p-7">
          <p>
            <span class="text-accent" aria-hidden="true">
              $
            </span>{' '}
            <span class="uses-type">
              <span class="uses-typed">uses --summary</span>
            </span>
          </p>

          <div class="mt-5 flex items-start gap-10">
            <svg
              class="uses-line uses-head mt-1 hidden shrink-0 sm:block"
              width="108"
              height="108"
              viewBox="0 0 24 24"
              fill="none"
              stroke="url(#uses-logo-gradient)"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <defs>
                <linearGradient
                  id="uses-logo-gradient"
                  x1="3"
                  y1="4"
                  x2="21"
                  y2="20"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop class="uses-stop-1"></stop>
                  <stop offset="1" class="uses-stop-2"></stop>
                </linearGradient>
              </defs>
              <path d="M5 7l6 5-6 5"></path>
              <path d="M13 18h6"></path>
            </svg>

            <div class="min-w-0 flex-1">
              <p class="uses-line uses-head text-fg">leon@leonkrix.dev</p>
              <p class="uses-line uses-head uses-rule" aria-hidden="true">
                ─────────────────
              </p>
              <dl class="uses-summary">
                {usesSummary.map((line) => (
                  <>
                    <dt class="uses-line text-accent-2">{line.label}</dt>
                    <dd class="uses-line min-w-0 text-muted">{line.value}</dd>
                  </>
                ))}
              </dl>
              <p class="uses-line uses-swatches" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </p>
            </div>
          </div>

          <p class="uses-line uses-end mt-5 text-muted" aria-hidden="true">
            <span class="text-accent">$</span> <span class="cursor text-accent-2">_</span>
          </p>
        </div>
      </div>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2">
        {usesCategories.map((category) => (
          <li class="reveal">
            <section
              aria-labelledby={`uses-${category.id}`}
              class="edge h-full rounded-xl border border-border bg-surface/40 p-6"
            >
              <div class="flex items-center gap-3">
                <span class="uses-tile">
                  <Icon name={category.icon} class="size-5" />
                </span>
                <h2 id={`uses-${category.id}`} class="text-lg font-semibold tracking-tight">
                  {category.title}
                </h2>
              </div>
              <ul class="mt-5 space-y-3">
                {category.items.map((item) => (
                  <li>
                    <p class="text-fg">{item.name}</p>
                    {item.detail !== undefined && <p class="text-sm text-muted">{item.detail}</p>}
                  </li>
                ))}
              </ul>
            </section>
          </li>
        ))}
      </ul>

      <p class="mt-10 text-sm text-muted">Updated {formatMonth(usesUpdated)}</p>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* The terminal block builds up like a real session: the window is there, the command is typed
     (a mask that opens with a caret in front of it, the box itself never changes size), then the
     header, the lines, the colours and the prompt appear one after the other. Only opacity,
     transform and clip-path change, so nothing on the page moves. Here and not in global.css, so
     that other pages do not carry it. */
  @keyframes uses-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    /* Written out: from an inset() to "none" the browser cannot step, it would jump */
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes uses-caret {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    99% {
      opacity: 1;
    }
    to {
      transform: translateX(14ch);
      opacity: 0;
    }
  }

  .uses-type {
    position: relative;
    display: inline-block;
  }

  .uses-typed {
    display: inline-block;
    animation: uses-type 900ms steps(14, end) 1s backwards;
  }

  .uses-type::after {
    content: '';
    position: absolute;
    top: 0.1em;
    bottom: 0.1em;
    left: 0;
    width: 0.55ch;
    background-color: var(--color-accent-2);
    opacity: 0;
    animation: uses-caret 900ms steps(14, end) 1s backwards;
  }

  .uses-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: color-mix(in srgb, var(--color-surface) 60%, transparent);
    color: var(--color-accent-2);
  }

  .uses-rule {
    color: var(--color-border);
  }

  .uses-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
    background-color: var(--color-border);
  }

  .uses-summary {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
  }

  .uses-swatches {
    display: flex;
    gap: 0.375rem;
    margin-top: 1.25rem;
  }

  .uses-swatches span {
    width: 1rem;
    height: 1rem;
    border-radius: 0.125rem;
  }

  .uses-swatches span:nth-child(1) {
    background-color: var(--color-accent);
  }

  .uses-swatches span:nth-child(2) {
    background-color: var(--color-accent-2);
  }

  .uses-swatches span:nth-child(3) {
    background-color: var(--color-contrast);
  }

  .uses-swatches span:nth-child(4) {
    background-color: var(--color-status);
  }

  .uses-swatches span:nth-child(5) {
    background-color: var(--color-muted);
  }

  .uses-swatches span:nth-child(6) {
    background-color: var(--color-fg);
  }

  .uses-stop-1 {
    stop-color: var(--color-accent);
  }

  .uses-stop-2 {
    stop-color: var(--color-accent-2);
  }

  /* The order of appearance: every part has a place --n, and starts n steps after the command was
     typed. The header (with the logo) is 0, the lines of the list are 1 to 12 (term and value of a
     line have the same number), the colours and the closing prompt come after them. */
  .uses-line {
    animation: rise 500ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(2s + var(--n, 0) * 90ms);
  }

  .uses-head {
    --n: 0;
  }

  .uses-terminal dl > :nth-child(1),
  .uses-terminal dl > :nth-child(2) {
    --n: 1;
  }

  .uses-terminal dl > :nth-child(3),
  .uses-terminal dl > :nth-child(4) {
    --n: 2;
  }

  .uses-terminal dl > :nth-child(5),
  .uses-terminal dl > :nth-child(6) {
    --n: 3;
  }

  .uses-terminal dl > :nth-child(7),
  .uses-terminal dl > :nth-child(8) {
    --n: 4;
  }

  .uses-terminal dl > :nth-child(9),
  .uses-terminal dl > :nth-child(10) {
    --n: 5;
  }

  .uses-terminal dl > :nth-child(11),
  .uses-terminal dl > :nth-child(12) {
    --n: 6;
  }

  .uses-terminal dl > :nth-child(13),
  .uses-terminal dl > :nth-child(14) {
    --n: 7;
  }

  .uses-terminal dl > :nth-child(15),
  .uses-terminal dl > :nth-child(16) {
    --n: 8;
  }

  .uses-terminal dl > :nth-child(17),
  .uses-terminal dl > :nth-child(18) {
    --n: 9;
  }

  .uses-terminal dl > :nth-child(19),
  .uses-terminal dl > :nth-child(20) {
    --n: 10;
  }

  .uses-terminal dl > :nth-child(21),
  .uses-terminal dl > :nth-child(22) {
    --n: 11;
  }

  .uses-terminal dl > :nth-child(23),
  .uses-terminal dl > :nth-child(24) {
    --n: 12;
  }

  .uses-swatches {
    --n: 13;
  }

  .uses-end {
    --n: 14;
  }

  @media (prefers-reduced-motion: reduce) {
    .uses-typed,
    .uses-type::after,
    .uses-line {
      animation: none;
    }
  }
</style>
