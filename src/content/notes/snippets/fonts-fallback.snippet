/* Shortened from src/styles/global.css */
@font-face {
  font-family: 'Inter Fallback';
  src: local('Arial'), local('Liberation Sans'), local('Arimo');
  font-weight: 100 500;
  size-adjust: 106.8%;
  ascent-override: 90.7%;
  descent-override: 22.6%;
  line-gap-override: 0%;
}

--font-sans: 'Inter Variable', 'Inter Fallback', ui-sans-serif,
  system-ui, sans-serif;
