---
import Icon from '@/components/Icon.astro';
import { type GameDefinition, gamesPath } from '@/games/registry';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/lib/site';

interface Props {
  game: GameDefinition;
}

const { game } = Astro.props;

// The shell around a game: title, the game itself (default slot) and three optional panels that
// work without JavaScript (native details): how to play, keyboard help, how it is built.
const panels = [
  { slot: 'rules', title: 'How to play' },
  { slot: 'keys', title: 'Keyboard' },
  { slot: 'built', title: 'How it is built' },
].filter((panel) => Astro.slots.has(panel.slot));
---

<BaseLayout
  title={`${game.name} | ${siteConfig.name}`}
  description={`${game.name}: ${game.description}`}
  calm
>
  <main id="main" class="flex-1">
    <div class="mx-auto max-w-5xl px-6 py-6 sm:py-16">
      <a
        href={gamesPath}
        class="inline-flex items-center gap-2 text-sm text-muted underline-offset-4 transition-colors hover:text-fg hover:underline"
      >
        <Icon name="lucide:arrow-left" class="size-4" />
        Playground
      </a>

      <header class="mt-3 sm:mt-6">
        <p class="font-mono text-sm text-accent-2">{game.tag}</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{game.name}</h1>
        <p class="mt-2 max-w-2xl text-base text-muted sm:mt-3 sm:text-lg">{game.description}</p>
      </header>

      <div class="mt-5 sm:mt-10">
        <slot />
      </div>

      {panels.length > 0 && (
        <div class="mt-14 space-y-4">
          {panels.map((panel) => (
            <details class="edge group rounded-xl border border-border bg-surface/50">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium [&::-webkit-details-marker]:hidden">
                {panel.title}
                <Icon
                  name="lucide:chevron-right"
                  class="size-4 text-muted transition-transform group-open:rotate-90"
                />
              </summary>
              <div class="game-prose max-w-2xl px-5 pb-5">
                <slot name={panel.slot} />
              </div>
            </details>
          ))}
        </div>
      )}
    </div>
  </main>
</BaseLayout>
