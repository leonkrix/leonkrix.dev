---
import '@/styles/global.css';

import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

import Background from '@/components/Background.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import Seo from '@/components/Seo.astro';
import { siteConfig } from '@/lib/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean | undefined;
  /** Pages with a lot of text get a calm background without the grid */
  calm?: boolean | undefined;
}

const {
  title = siteConfig.title,
  description,
  image,
  imageAlt,
  noindex,
  calm = false,
} = Astro.props;
---

<!doctype html>
<!--
  Hello! You are reading the source of leonkrix.dev, so you are my kind of visitor.
  The code is public: https://github.com/leonkrix/leonkrix.dev
  How it is built: https://leonkrix.dev/notes/
  Press Ctrl K (or Cmd K) for the command palette, and type ">" in it for a terminal.
  Security contact: https://leonkrix.dev/.well-known/security.txt
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {/* The two fonts of every page, requested at once, before the stylesheet is read (see tests/build-output/fonts.test.ts) */}
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body class="relative flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-fg"
    >
      Skip to content
    </a>
    <Background grid={!calm} />
    <Header />
    <slot />
    <Footer />
  </body>
</html>
