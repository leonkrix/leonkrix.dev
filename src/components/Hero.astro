---
import AvailabilityBadge from '@/components/AvailabilityBadge.astro';
import Icon from '@/components/Icon.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { siteConfig } from '@/lib/site';
---

<div class="mx-auto flex min-h-[calc(100dvh-4rem)] max-w-5xl flex-col justify-center px-6 py-16">
  <div class="hero-in mb-8 [--i:0]">
    <AvailabilityBadge />
  </div>
  <p class="hero-in font-mono text-sm text-accent-2 [--i:1]">Hello, I'm</p>
  <h1 class="hero-in mt-4 text-5xl font-semibold tracking-tight [--i:2] sm:text-7xl">
    {siteConfig.name}
  </h1>
  <p class="hero-in mt-3 bg-linear-to-r from-accent to-accent-2 bg-clip-text text-2xl font-medium text-transparent [--i:3] sm:text-3xl">
    {siteConfig.role}
  </p>
  <p class="hero-in mt-8 max-w-xl text-lg leading-relaxed text-muted [--i:4]">
    I build software across the stack, from low-level code and machine learning to web and mobile
    applications, with a focus on clean code, thoughtful design and reliable tooling.
  </p>

  <div class="hero-in mt-10 flex flex-wrap items-center gap-3 [--i:5]">
    <a
      href="#projects"
      class="btn-primary group inline-flex items-center gap-2 rounded-lg px-5 py-3 text-sm font-medium"
    >
      View projects
      <Icon
        name="lucide:arrow-down"
        class="size-4 transition-transform duration-200 group-hover:translate-y-0.5"
      />
    </a>
    <a
      href="#contact"
      class="btn-outline inline-flex items-center gap-2 rounded-lg px-5 py-3 text-sm font-medium text-fg"
    >
      Contact
      <Icon name="lucide:mail" class="size-4" />
    </a>
  </div>

  <SocialLinks class="hero-in mt-8 [--i:6]" />
</div>
