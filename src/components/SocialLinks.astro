---
import ExternalLink from '@/components/ExternalLink.astro';
import Icon from '@/components/Icon.astro';
import ProtectedEmail from '@/components/ProtectedEmail.astro';
import { siteConfig, socialLinks } from '@/lib/site';

interface Props {
  class?: string | undefined;
  /** Adds the (protected) email address as first button */
  withEmail?: boolean | undefined;
}

const { class: className, withEmail = false } = Astro.props;
const buttonClass =
  'btn-outline inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm text-muted hover:text-fg';
---

<ul class:list={['flex flex-wrap items-center gap-3', className]} aria-label="Profiles">
  {withEmail && (
    <li>
      <ProtectedEmail address={siteConfig.email} icon="lucide:mail" class={buttonClass} />
    </li>
  )}
  {socialLinks.map((link) => (
    <li>
      <ExternalLink href={link.href} class={buttonClass}>
        <Icon name={link.icon} class="size-4" />
        {link.label}
      </ExternalLink>
    </li>
  ))}
</ul>
