---
import { availability } from '@/lib/site';
---

{availability.open && (
  <a
    href="#contact"
    class="inline-flex items-center gap-2.5 rounded-full border border-border bg-surface/60 px-3.5 py-1.5 font-mono text-xs text-muted transition-colors hover:border-status/60 hover:text-fg"
  >
    <span class="relative flex size-2">
      <span
        aria-hidden="true"
        class="absolute inline-flex size-full animate-ping rounded-full bg-status opacity-60"
      />
      <span aria-hidden="true" class="relative inline-flex size-2 rounded-full bg-status" />
    </span>
    {availability.label}
  </a>
)}
