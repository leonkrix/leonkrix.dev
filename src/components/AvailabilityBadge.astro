---
import Icon from '@/components/Icon.astro';
import { availability } from '@/lib/site';
---

{availability.open && (
  <a
    href="#contact"
    class="badge-glow group inline-flex items-center gap-2.5 rounded-full border border-border bg-surface/60 px-3.5 py-1.5 font-mono text-xs text-muted transition-colors hover:border-status/60 hover:text-fg"
  >
    <span class="relative flex size-2">
      <span
        aria-hidden="true"
        class="badge-ring absolute inline-flex size-full rounded-full bg-status"
      />
      <span aria-hidden="true" class="relative inline-flex size-2 rounded-full bg-status" />
    </span>
    {availability.label}
    <Icon
      name="lucide:arrow-right"
      class="-ml-2 size-3 w-0 shrink-0 text-status opacity-0 transition-all duration-300 group-hover:ml-0 group-hover:w-3 group-hover:opacity-100"
    />
  </a>
)}
