---
// Two topics of Link Up that must never meet in one puzzle: the terms are real entries of the data
// (a build-time check below fails if the data changes and the picture would no longer be true).
import { categories, conflicts } from '@/games/link-up/data';

import Figure from './Figure.astro';

const http = categories.find((category) => category.id === 'http-methods');
const sql = categories.find((category) => category.id === 'sql-commands');
const delet = 'DELETE';
const kept = ['GET', 'POST', 'PUT'];
const sqlTerms = ['SELECT', 'INSERT', 'UPDATE'];

const listed = (category: typeof http, term: string): boolean =>
  category?.terms.some((entry) => entry.name === term) ?? false;
const pairListed = conflicts.some(
  ([first, second]) =>
    (first === 'http-methods' && second === 'sql-commands') ||
    (first === 'sql-commands' && second === 'http-methods'),
);

if (
  !kept.every((term) => listed(http, term)) ||
  !listed(http, delet) ||
  !sqlTerms.every((term) => listed(sql, term)) ||
  listed(sql, delet) ||
  !pairListed
) {
  throw new Error('ConflictFigure: the data of Link Up no longer matches the picture.');
}

const groups = [
  {
    name: http?.name ?? '',
    tiles: [...kept, delet].map((term) => ({ term, kind: term === delet ? 'owner' : 'plain' })),
  },
  {
    name: sql?.name ?? '',
    tiles: [...sqlTerms, delet].map((term) => ({
      term,
      kind: term === delet ? 'lookalike' : 'plain',
    })),
  },
];
---

<Figure caption="In the data, DELETE belongs to “HTTP methods” and nowhere else (solid, amber). But in a puzzle with both topics it would also pass for an SQL command (dashed), and a player could put it there and be right. So the two topics are on a list of pairs that never meet.">
  <div class="groups">
    {groups.map((group) => (
      <div>
        <p class="group-name">{group.name}</p>
        <ul>
          {group.tiles.map((tile) => (
            <li data-kind={tile.kind}>
              {tile.term}
              {tile.kind === 'lookalike' && (
                <span class="sr-only"> (the same word as in HTTP methods)</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Figure>

<style>
  .groups {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 36rem) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .group-name {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  li {
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-surface);
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono), monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  li[data-kind='owner'] {
    border-color: var(--color-contrast);
    background: color-mix(in srgb, var(--color-contrast) 18%, var(--color-surface));
  }

  li[data-kind='lookalike'] {
    border-style: dashed;
    border-color: var(--color-contrast);
    color: var(--color-muted);
  }
</style>
