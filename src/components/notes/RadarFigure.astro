---
// A real round of Word Radar for the hidden word "volcano": the rings are ranks 10, 100, 1,000 and
// 10,000 (a logarithm, so the rings are equally far apart), and every dot is a guess, placed by
// the game's own functions (see radar-example.ts). Nothing here is drawn by hand.
import Figure from './Figure.astro';
import { radarExample, RINGS, SECRET } from './radar-example';

const example = radarExample();
const format = new Intl.NumberFormat('en');
const near = example.dots.map((dot) => `${dot.word} (rank ${format.format(dot.rank)})`).join(', ');
// Where the word is written: near the middle, away from the hidden word (on the outer side of the
// dot), further out above or below the dot, at the edge towards the middle
const labelAt = (dot: { x: number; y: number }): { x: number; y: number; anchor: string } => {
  const radius = Math.hypot(dot.x, dot.y);
  if (radius < 30) {
    return { x: (dot.x / radius) * 7, y: (dot.y / radius) * 7 + 2, anchor: 'middle' };
  }
  return {
    x: 0,
    y: dot.y > 0 ? -4.5 : 8,
    anchor: dot.x > 50 ? 'end' : dot.x < -50 ? 'start' : 'middle',
  };
};
const label = `A radar for the hidden word ${SECRET}. Guesses, from near to far: ${[...example.dots]
  .sort((a, b) => a.rank - b.rank)
  .map((dot) => `${dot.word}, rank ${format.format(dot.rank)}`)
  .join('; ')}.`;
---

<Figure
  caption={`A real round for the hidden word “${SECRET}”, worked out from the game's data when this page is built. The distance from the middle is the logarithm of the rank; the direction comes from the plane of the 300 nearest words. Guessed: ${near}.`}
>
  <svg viewBox="-100 -100 200 200" role="img" aria-label={label}>
    <circle class="disc" r="96"></circle>
    {RINGS.map((ring) => (
      <g>
        <circle class="ring" r={example.ringRadius(ring.rank)}></circle>
        <text class="ring-label" x="0" y={-example.ringRadius(ring.rank) - 1.5}>
          {ring.label}
        </text>
      </g>
    ))}
    <line class="axis" x1="-96" y1="0" x2="96" y2="0"></line>
    <line class="axis" x1="0" y1="-96" x2="0" y2="96"></line>
    <g>
      <circle class="target" r="3.6"></circle>
      <text class="target-label" y="-6.5">
        {SECRET}
      </text>
    </g>
    {example.dots.map((dot) => (
      <g transform={`translate(${dot.x.toFixed(2)} ${dot.y.toFixed(2)})`} data-bucket={dot.bucket}>
        <circle class="dot" r="2.8"></circle>
        <text
          class="dot-label"
          x={labelAt(dot).x}
          y={labelAt(dot).y}
          text-anchor={labelAt(dot).anchor}
        >
          {dot.word}
        </text>
      </g>
    ))}
  </svg>
</Figure>

<style>
  svg {
    display: block;
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
  }

  .disc {
    fill: color-mix(in srgb, var(--color-bg) 80%, var(--color-surface));
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .ring {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 0.6;
  }

  .ring-label {
    fill: var(--color-muted);
    font-family: var(--font-mono), monospace;
    font-size: 4.2px;
    text-anchor: middle;
  }

  .axis {
    stroke: var(--color-border);
    stroke-width: 0.4;
    stroke-dasharray: 2 3;
    opacity: 0.7;
  }

  .target {
    fill: var(--color-status);
  }

  .target-label {
    fill: var(--color-fg);
    font-family: var(--font-mono), monospace;
    font-size: 5px;
    font-weight: 700;
    text-anchor: middle;
  }

  .dot {
    fill: var(--c, var(--color-muted));
  }

  .dot-label {
    fill: var(--color-fg);
    font-family: var(--font-mono), monospace;
    font-size: 4.6px;
  }

  /* The colours of the game: burning, hot, warm, cool and cold guesses */
  [data-bucket='burning'] {
    --c: var(--color-danger);
  }

  [data-bucket='hot'] {
    --c: var(--color-contrast);
  }

  [data-bucket='warm'] {
    --c: var(--color-accent-2);
  }

  [data-bucket='cool'] {
    --c: var(--color-accent);
  }

  [data-bucket='cold'] {
    --c: var(--color-muted);
  }
</style>
