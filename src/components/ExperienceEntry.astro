---
import Icon from '@/components/Icon.astro';
import { type ExperienceEntry, formatRange } from '@/lib/experience';

interface Props {
  entry: ExperienceEntry;
  icon: string;
  /** Title of the related project, shown as a link to its card */
  relatedProjectTitle?: string | undefined;
}

const { entry, icon, relatedProjectTitle } = Astro.props;
---

<li class="flex gap-4 py-8 first:pt-0 last:pb-0 sm:gap-5">
  <div
    aria-hidden="true"
    class="grid size-10 shrink-0 place-items-center rounded-lg border border-border bg-surface text-accent"
  >
    <Icon name={icon} class="size-5" />
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
      <h4 class="text-lg font-semibold tracking-tight">{entry.title}</h4>
      <p class="font-mono text-sm whitespace-nowrap text-accent-2">{formatRange(entry)}</p>
    </div>
    <p class="mt-0.5 text-muted">
      {entry.organization}
      {entry.unit && <span> · {entry.unit}</span>}
    </p>

    <ul class="mt-4 space-y-2 text-muted">
      {entry.highlights.map((highlight) => (
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2.5 size-1 shrink-0 rounded-full bg-accent-2" />
          <span>{highlight}</span>
        </li>
      ))}
    </ul>

    {entry.coursework && (
      <div class="mt-4">
        <p class="text-sm font-medium text-fg">Coursework</p>
        <ul class="mt-2 flex flex-wrap gap-2">
          {entry.coursework.map((course) => (
            <li class="rounded-full border border-border bg-surface/60 px-3 py-1 text-sm text-muted">
              {course}
            </li>
          ))}
        </ul>
      </div>
    )}

    {entry.relatedProject && relatedProjectTitle && (
      <a
        href={`#project-${entry.relatedProject}`}
        class="mt-4 inline-flex items-start gap-2 text-sm text-accent underline-offset-4 hover:underline"
      >
        <Icon name="lucide:arrow-down-right" class="mt-0.5 size-4 shrink-0" />
        <span>Thesis: {relatedProjectTitle}</span>
      </a>
    )}
  </div>
</li>
