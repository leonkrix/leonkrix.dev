---
import ExternalLink from '@/components/ExternalLink.astro';
import Icon from '@/components/Icon.astro';
import ProjectArt from '@/components/project-art/ProjectArt.astro';
import TechList from '@/components/TechList.astro';
import { kindLabels, type Project } from '@/lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="edge rounded-xl border border-border bg-surface/50 p-6 sm:p-7">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="inline-flex rounded-full border border-border px-2.5 py-0.5 font-mono text-xs text-muted">
      {kindLabels[project.kind]}
      {project.institution && ` · ${project.institution}`}
    </p>
    {project.grade && (
      <p class="inline-flex rounded-full border border-accent/40 bg-accent/10 px-2.5 py-0.5 font-mono text-xs text-accent">
        Grade {project.grade}
        <span class="sr-only"> (best possible in the German grading system)</span>
      </p>
    )}
  </div>
  {/* With a picture the title and the key figures are one column and the picture stands beside
     them over their whole height; on narrow screens the picture is a strip below the subtitle */}
  <div
    class:list={['mt-3', project.art && 'md:grid md:grid-cols-[minmax(0,1fr)_15rem] md:gap-x-8']}
  >
    <div class:list={[project.art && 'md:col-start-1 md:row-start-1']}>
      <h3 class="text-xl font-semibold tracking-tight text-balance">{project.title}</h3>
      {project.subtitle && <p class="mt-1 text-muted">{project.subtitle}</p>}
    </div>
    {project.art && (
      <div class="mt-4 md:col-start-2 md:row-span-2 md:row-start-1 md:mt-0">
        <ProjectArt art={project.art} />
      </div>
    )}
    {project.stats && (
      <dl
        class:list={[
          'mt-6 grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-x-6 gap-y-4 rounded-lg border border-border bg-bg/40 p-4',
          project.art && 'md:col-start-1 md:row-start-2',
        ]}
      >
        {project.stats.map((stat) => (
          <div class="flex flex-col-reverse justify-end gap-1">
            <dt class="text-sm text-muted">{stat.label}</dt>
            <dd class="font-mono text-xl font-semibold text-accent-2">{stat.value}</dd>
          </div>
        ))}
      </dl>
    )}
    {/* The highlights: below everything, or (when there are no key figures) beside the picture */}
    <ul
      class:list={[
        'mt-5 space-y-2.5 text-muted',
        project.art && project.stats && 'md:col-span-2 md:row-start-3',
        project.art && !project.stats && 'md:col-start-1 md:row-start-2',
      ]}
    >
      {project.highlights.map((highlight) => (
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2.5 size-1 shrink-0 rounded-full bg-accent-2" />
          <span>{highlight}</span>
        </li>
      ))}
    </ul>
  </div>

  <TechList class="mt-6" items={project.technologies} />

  <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
    {project.code.status === 'public' ? (
      <ExternalLink
        href={project.code.url}
        class="btn-outline inline-flex items-center gap-2 rounded-lg px-4 py-2 text-fg"
      >
        <Icon name="simple-icons:github" class="size-4" />
        View on GitHub
      </ExternalLink>
    ) : (
      <p class="inline-flex items-center gap-2 text-muted">
        <Icon
          name={project.code.status === 'planned' ? 'lucide:clock' : 'lucide:lock'}
          class="size-4"
        />
        {project.code.status === 'planned' ? 'Code coming soon' : 'Private project'}
      </p>
    )}
    {project.note && <p class="text-muted">{project.note}</p>}
  </div>
</article>
