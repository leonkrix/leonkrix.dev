---
// The layout guard in ten seconds, in two halves. First half: a page with three blocks, a banner
// arrives at the top and pushes the blocks down; the old places show as dashed outlines, the moved
// blocks get an amber frame, and the guard's report says what moved and how far (the test fails).
// Second half: the same page, but the space for the banner was reserved from the start (a dashed
// slot); the banner arrives in it, nothing moves, and the guard says so (the test passes).
//
// Pure CSS and SVG, the same coordinates (240 by 200) and label size as the other pictures of the
// project cards. The base style of every part is the frame that tells the story of the first half
// (used with reduced motion, and before the animation starts); the keyframes play both halves and
// fade the whole scene out at the end of the loop. Times of the loop (10 s, so 10 per cent are one
// second): the banner 1.5 s, the blocks move at 1.9 s, the report at 2.9 s, the switch to the second
// half at 4.5 s to 5 s, the banner in the slot at 6.6 s, the pass at 7.3 s.
---

<svg
  viewBox="0 0 240 200"
  class="guard block h-full w-full"
  preserveAspectRatio="xMidYMid meet"
  focusable="false"
>
  <defs>
    <g id="lg-blocks">
      <rect class="lg-card" x="42" y="44" width="156" height="26" rx="4" />
      <rect class="lg-line-a" x="50" y="51" width="58" height="4" rx="2" />
      <rect class="lg-line-b" x="50" y="60" width="108" height="3" rx="1.5" />
      <rect class="lg-card" x="42" y="76" width="156" height="26" rx="4" />
      <rect class="lg-line-a" x="50" y="83" width="74" height="4" rx="2" />
      <rect class="lg-line-b" x="50" y="92" width="96" height="3" rx="1.5" />
      <rect class="lg-card" x="42" y="108" width="156" height="26" rx="4" />
      <rect class="lg-line-a" x="50" y="115" width="48" height="4" rx="2" />
      <rect class="lg-line-b" x="50" y="124" width="120" height="3" rx="1.5" />
    </g>
  </defs>

  <g class="lg-scene">
    <text class="lg-title" x="5" y="10">
      layout-guard
    </text>

    <rect class="lg-window" x="30" y="20" width="180" height="140" rx="8" />
    <path class="lg-bar" d="M30 34H210" />
    <circle class="lg-dot" cx="40" cy="27" r="2" />
    <circle class="lg-dot" cx="47" cy="27" r="2" />
    <circle class="lg-dot" cx="54" cy="27" r="2" />

    <!-- First half: the banner pushes the blocks down -->
    <g class="lg-a">
      <g class="lg-ghosts">
        <rect class="lg-ghost" x="42" y="44" width="156" height="26" rx="4" />
        <rect class="lg-ghost" x="42" y="76" width="156" height="26" rx="4" />
        <rect class="lg-ghost" x="42" y="108" width="156" height="26" rx="4" />
      </g>
      <use href="#lg-blocks" class="lg-a-blocks" />
      <g class="lg-moved">
        <rect class="lg-moved-box" x="42" y="60" width="156" height="26" rx="4" />
        <rect class="lg-moved-box" x="42" y="92" width="156" height="26" rx="4" />
        <rect class="lg-moved-box" x="42" y="124" width="156" height="26" rx="4" />
      </g>
      <rect class="lg-banner lg-a-banner" x="42" y="44" width="156" height="12" rx="4" />
      <g class="lg-report">
        <rect class="lg-report-box" x="30" y="164" width="180" height="14" rx="7" />
        <text class="lg-report-text" x="120" y="173.8">
          main moved 16 px down
        </text>
      </g>
    </g>

    <!-- Second half: the space was reserved, nothing moves -->
    <g class="lg-b">
      <rect class="lg-slot" x="42" y="44" width="156" height="12" rx="4" />
      <use href="#lg-blocks" transform="translate(0 16)" />
      <rect class="lg-banner lg-b-banner" x="42" y="44" width="156" height="12" rx="4" />
      <g class="lg-pass">
        <rect class="lg-pass-box" x="30" y="164" width="180" height="14" rx="7" />
        <text class="lg-pass-text" x="120" y="173.8">
          0 shifts, test passed
        </text>
      </g>
    </g>

    <text class="lg-cap lg-cap-1" x="120" y="194">
      A Banner Pushes the Page
    </text>
    <text class="lg-cap lg-cap-2" x="120" y="194">
      The Guard Fails the Test
    </text>
    <text class="lg-cap lg-cap-3" x="120" y="194">
      Space Reserved, Nothing Moves
    </text>
  </g>
</svg>

<style>
  .lg-title,
  .lg-report-text,
  .lg-pass-text,
  .lg-cap {
    font-family: var(--font-mono), monospace;
    font-size: 8.5px;
    letter-spacing: 0.02em;
  }

  .lg-title {
    fill: var(--color-accent-2);
    opacity: 0.8;
  }

  .lg-window {
    fill: color-mix(in srgb, var(--color-surface) 75%, transparent);
    stroke: var(--color-border);
    stroke-width: 1.2;
  }

  .lg-bar {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .lg-dot {
    fill: var(--color-muted);
    opacity: 0.6;
  }

  .lg-card {
    fill: var(--color-bg);
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .lg-line-a {
    fill: var(--color-fg);
    opacity: 0.8;
  }

  .lg-line-b {
    fill: var(--color-muted);
    opacity: 0.6;
  }

  .lg-banner {
    fill: color-mix(in srgb, var(--color-contrast) 30%, transparent);
    stroke: var(--color-contrast);
    stroke-width: 1;
  }

  /* The frame that tells the story: the first half, after the guard has seen it */
  .lg-a-blocks {
    transform: translateY(16px);
  }

  .lg-ghost,
  .lg-slot {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .lg-moved-box {
    fill: none;
    stroke: var(--color-contrast);
    stroke-width: 1.4;
  }

  .lg-report-box,
  .lg-pass-box {
    fill: color-mix(in srgb, var(--color-contrast) 12%, transparent);
    stroke: var(--color-contrast);
    stroke-width: 1.2;
  }

  .lg-report-text {
    fill: var(--color-contrast);
    text-anchor: middle;
  }

  .lg-pass-box {
    fill: color-mix(in srgb, var(--color-status) 14%, transparent);
    stroke: var(--color-status);
  }

  .lg-pass-text {
    fill: var(--color-status);
    text-anchor: middle;
  }

  .lg-b {
    opacity: 0;
  }

  .lg-cap {
    text-anchor: middle;
    opacity: 0;
  }

  .lg-cap-2 {
    fill: var(--color-contrast);
    opacity: 0.95;
  }

  .lg-cap-1 {
    fill: var(--color-muted);
  }

  .lg-cap-3 {
    fill: var(--color-status);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lg-scene {
      animation: lg-scene 10s linear infinite;
    }

    .lg-a {
      animation: lg-a 10s linear infinite;
    }

    .lg-b {
      animation: lg-b 10s linear infinite;
    }

    .lg-a-blocks {
      animation: lg-blocks 10s ease-in-out infinite;
    }

    .lg-a-banner {
      animation: lg-banner 10s ease-out infinite;
    }

    .lg-ghosts {
      animation: lg-ghosts 10s linear infinite;
    }

    .lg-moved {
      animation: lg-moved 10s linear infinite;
    }

    .lg-report {
      animation: lg-report 10s linear infinite;
    }

    .lg-b-banner {
      animation: lg-b-banner 10s ease-out infinite;
    }

    .lg-pass {
      animation: lg-pass 10s linear infinite;
    }

    .lg-cap-1 {
      animation: lg-cap-1 10s linear infinite;
    }

    .lg-cap-2 {
      animation: lg-cap-2 10s linear infinite;
    }

    .lg-cap-3 {
      animation: lg-cap-3 10s linear infinite;
    }
  }

  @keyframes lg-scene {
    0% {
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    93% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes lg-a {
    0%,
    45% {
      opacity: 1;
    }
    49%,
    100% {
      opacity: 0;
    }
  }

  @keyframes lg-b {
    0%,
    50% {
      opacity: 0;
    }
    54%,
    100% {
      opacity: 1;
    }
  }

  @keyframes lg-blocks {
    0%,
    15% {
      transform: translateY(0);
    }
    19%,
    100% {
      transform: translateY(16px);
    }
  }

  @keyframes lg-banner {
    0%,
    14% {
      opacity: 0;
      transform: translateY(-8px);
    }
    19%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes lg-ghosts {
    0%,
    19% {
      opacity: 0;
    }
    23%,
    100% {
      opacity: 1;
    }
  }

  @keyframes lg-moved {
    0%,
    21% {
      opacity: 0;
    }
    25%,
    100% {
      opacity: 1;
    }
  }

  @keyframes lg-report {
    0%,
    27% {
      opacity: 0;
    }
    31%,
    100% {
      opacity: 1;
    }
  }

  @keyframes lg-b-banner {
    0%,
    62% {
      opacity: 0;
      transform: translateY(-8px);
    }
    67%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes lg-pass {
    0%,
    71% {
      opacity: 0;
    }
    75%,
    100% {
      opacity: 1;
    }
  }

  @keyframes lg-cap-1 {
    0%,
    6% {
      opacity: 0;
    }
    10%,
    17% {
      opacity: 0.85;
    }
    20%,
    100% {
      opacity: 0;
    }
  }

  @keyframes lg-cap-2 {
    0%,
    19% {
      opacity: 0;
    }
    23%,
    43% {
      opacity: 0.95;
    }
    46%,
    100% {
      opacity: 0;
    }
  }

  @keyframes lg-cap-3 {
    0%,
    52% {
      opacity: 0;
    }
    56%,
    100% {
      opacity: 0.95;
    }
  }
</style>
