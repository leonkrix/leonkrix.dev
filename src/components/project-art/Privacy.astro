---
// The privacy guard in twelve seconds, in two halves. First half: a page sends requests out to another
// origin (a dashed box, "tracker.io") and a cookie lands in the browser; the box lights up amber and
// the guard's report says what it found (the test fails). Second half: the same page, but everything
// stays inside the window; the other origin stays dark and the guard says so (the test passes).
//
// Pure CSS and SVG, the same coordinates (240 by 200) and label size as the other pictures of the
// project cards. The base style of every part is the frame that tells the story of the first half
// (used with reduced motion, and before the animation starts); the keyframes play both halves and
// fade the whole scene out at the end of the loop. Times of the loop (12 s): the packets leave at 1.6 s and
// 2.0 s, the cookie lands at 3.4 s, the report at 4.0 s and stays until the switch to the second half at
// 5.6 s to 6.6 s (long enough to read it), the packet goes to and fro at 7 s, the pass at 8.6 s.
---

<svg
  viewBox="0 0 240 200"
  class="privacy block h-full w-full"
  preserveAspectRatio="xMidYMid meet"
  focusable="false"
>
  <g class="pg-scene">
    <text class="pg-title" x="5" y="10">
      privacy-guard
    </text>

    <rect class="pg-window" x="10" y="20" width="140" height="112" rx="8"></rect>
    <path class="pg-bar" d="M10 34H150"></path>
    <circle class="pg-dot" cx="20" cy="27" r="2"></circle>
    <circle class="pg-dot" cx="27" cy="27" r="2"></circle>
    <circle class="pg-dot" cx="34" cy="27" r="2"></circle>
    <rect class="pg-card" x="20" y="42" width="120" height="26" rx="4"></rect>
    <rect class="pg-line-a" x="28" y="49" width="52" height="4" rx="2"></rect>
    <rect class="pg-line-b" x="28" y="58" width="88" height="3" rx="1.5"></rect>
    <rect class="pg-card" x="20" y="76" width="120" height="26" rx="4"></rect>
    <rect class="pg-line-a" x="28" y="83" width="68" height="4" rx="2"></rect>
    <rect class="pg-line-b" x="28" y="92" width="76" height="3" rx="1.5"></rect>

    <rect class="pg-origin" x="176" y="52" width="56" height="44" rx="6"></rect>
    <text class="pg-origin-label" x="204" y="110">
      tracker.io
    </text>

    <!-- First half: requests leave, a cookie lands -->
    <g class="pg-a">
      <path class="pg-wire" d="M140 72H176"></path>
      <circle class="pg-packet pg-p1" cx="142" cy="72" r="3"></circle>
      <circle class="pg-packet pg-p2" cx="142" cy="72" r="3"></circle>
      <g class="pg-cookie">
        <circle class="pg-cookie-body" cx="30" cy="118" r="6"></circle>
        <circle class="pg-crumb" cx="28" cy="116" r="1"></circle>
        <circle class="pg-crumb" cx="32" cy="119" r="1"></circle>
        <circle class="pg-crumb" cx="28" cy="121" r="1"></circle>
        <text class="pg-cookie-text" x="42" y="121">
          _ga
        </text>
      </g>
      <g class="pg-report">
        <rect class="pg-report-box" x="30" y="164" width="180" height="14" rx="7"></rect>
        <text class="pg-report-text" x="120" y="173.8">
          2 problems: request, cookie
        </text>
      </g>
    </g>

    <!-- Second half: everything stays inside -->
    <g class="pg-b">
      <circle class="pg-packet pg-p3" cx="34" cy="72" r="3"></circle>
      <g class="pg-pass">
        <rect class="pg-pass-box" x="30" y="164" width="180" height="14" rx="7"></rect>
        <text class="pg-pass-text" x="120" y="173.8">
          0 problems, test passed
        </text>
      </g>
    </g>

    <text class="pg-cap pg-cap-1" x="120" y="194">
      A Page Calls Out
    </text>
    <text class="pg-cap pg-cap-2" x="120" y="194">
      The Guard Fails the Test
    </text>
    <text class="pg-cap pg-cap-3" x="120" y="194">
      Everything Stays Home
    </text>
  </g>
</svg>

<style>
  .pg-title,
  .pg-origin-label,
  .pg-cookie-text,
  .pg-report-text,
  .pg-pass-text,
  .pg-cap {
    font-family: var(--font-mono), monospace;
    font-size: 8.5px;
    letter-spacing: 0.02em;
  }

  .pg-title {
    fill: var(--color-accent-2);
    opacity: 0.8;
  }

  .pg-window {
    fill: color-mix(in srgb, var(--color-surface) 75%, transparent);
    stroke: var(--color-border);
    stroke-width: 1.2;
  }

  .pg-bar {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .pg-dot {
    fill: var(--color-muted);
    opacity: 0.6;
  }

  .pg-card {
    fill: var(--color-bg);
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .pg-line-a {
    fill: var(--color-fg);
    opacity: 0.8;
  }

  .pg-line-b {
    fill: var(--color-muted);
    opacity: 0.6;
  }

  /* The other origin: dark and dashed, amber once something reaches it */
  .pg-origin {
    fill: none;
    stroke: var(--color-contrast);
    stroke-width: 1.2;
    stroke-dasharray: 3 3;
  }

  .pg-origin-label {
    fill: var(--color-muted);
    text-anchor: middle;
  }

  .pg-wire {
    stroke: var(--color-muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .pg-packet {
    fill: var(--color-accent-2);
  }

  /* The frame that tells the story: the first half, after the guard has seen it */
  .pg-p1,
  .pg-p2 {
    fill: var(--color-contrast);
    transform: translateX(34px);
  }

  .pg-cookie-body {
    fill: color-mix(in srgb, var(--color-contrast) 30%, transparent);
    stroke: var(--color-contrast);
    stroke-width: 1;
  }

  .pg-crumb {
    fill: var(--color-contrast);
  }

  .pg-cookie-text {
    fill: var(--color-contrast);
  }

  .pg-report-box,
  .pg-pass-box {
    fill: color-mix(in srgb, var(--color-contrast) 12%, transparent);
    stroke: var(--color-contrast);
    stroke-width: 1.2;
  }

  .pg-report-text {
    fill: var(--color-contrast);
    text-anchor: middle;
  }

  .pg-pass-box {
    fill: color-mix(in srgb, var(--color-status) 14%, transparent);
    stroke: var(--color-status);
  }

  .pg-pass-text {
    fill: var(--color-status);
    text-anchor: middle;
  }

  .pg-b {
    opacity: 0;
  }

  .pg-cap {
    text-anchor: middle;
    opacity: 0;
  }

  .pg-cap-2 {
    fill: var(--color-contrast);
    opacity: 0.95;
  }

  .pg-cap-1 {
    fill: var(--color-muted);
  }

  .pg-cap-3 {
    fill: var(--color-status);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pg-scene {
      animation: pg-scene 12s linear infinite;
    }

    .pg-a {
      animation: pg-a 12s linear infinite;
    }

    .pg-b {
      animation: pg-b 12s linear infinite;
    }

    .pg-origin {
      animation: pg-origin 12s linear infinite;
    }

    .pg-p1 {
      animation: pg-out 12s linear infinite backwards;
    }

    .pg-p2 {
      animation: pg-out 12s linear 0.4s infinite backwards;
    }

    .pg-p3 {
      animation: pg-in 12s ease-in-out infinite;
    }

    .pg-cookie {
      animation: pg-cookie 12s ease-out infinite;
    }

    .pg-report {
      animation: pg-report 12s linear infinite;
    }

    .pg-pass {
      animation: pg-pass 12s linear infinite;
    }

    .pg-cap-1 {
      animation: pg-cap-1 12s linear infinite;
    }

    .pg-cap-2 {
      animation: pg-cap-2 12s linear infinite;
    }

    .pg-cap-3 {
      animation: pg-cap-3 12s linear infinite;
    }
  }

  @keyframes pg-scene {
    0% {
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    93% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes pg-a {
    0%,
    47% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @keyframes pg-b {
    0%,
    52% {
      opacity: 0;
    }
    55%,
    100% {
      opacity: 1;
    }
  }

  @keyframes pg-origin {
    0%,
    23% {
      stroke: var(--color-muted);
    }
    27%,
    47% {
      stroke: var(--color-contrast);
    }
    51%,
    100% {
      stroke: var(--color-muted);
    }
  }

  @keyframes pg-out {
    0%,
    12% {
      opacity: 0;
      transform: translateX(0);
    }
    13% {
      opacity: 1;
      transform: translateX(0);
    }
    24% {
      opacity: 1;
      transform: translateX(34px);
    }
    27%,
    100% {
      opacity: 0;
      transform: translateX(34px);
    }
  }

  @keyframes pg-in {
    0%,
    56% {
      opacity: 0;
      transform: translateX(0);
    }
    58% {
      opacity: 1;
      transform: translateX(0);
    }
    67% {
      opacity: 1;
      transform: translateX(104px);
    }
    75% {
      opacity: 1;
      transform: translateX(0);
    }
    77.5%,
    100% {
      opacity: 0;
      transform: translateX(0);
    }
  }

  @keyframes pg-cookie {
    0%,
    27% {
      opacity: 0;
      transform: translateY(-10px);
    }
    32%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pg-report {
    0%,
    33% {
      opacity: 0;
    }
    37%,
    100% {
      opacity: 1;
    }
  }

  @keyframes pg-pass {
    0%,
    71% {
      opacity: 0;
    }
    75%,
    100% {
      opacity: 1;
    }
  }

  @keyframes pg-cap-1 {
    0%,
    5% {
      opacity: 0;
    }
    8%,
    16% {
      opacity: 0.85;
    }
    20%,
    100% {
      opacity: 0;
    }
  }

  @keyframes pg-cap-2 {
    0%,
    19% {
      opacity: 0;
    }
    22.5%,
    46.5% {
      opacity: 0.95;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @keyframes pg-cap-3 {
    0%,
    54% {
      opacity: 0;
    }
    57.5%,
    100% {
      opacity: 0.95;
    }
  }
</style>
