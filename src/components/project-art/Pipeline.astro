    fill: var(--color-accent);
  }

  .pl-btn-ghost {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .pl-ring {
    fill: none;
    stroke: var(--color-status);
    stroke-width: 2;
  }

  .pl-gauge {
    transform-box: fill-box;
    transform-origin: center;
  }

  .pl-gauge-text {
    fill: var(--color-status);
    text-anchor: middle;
  }

  .pl-cap {
    text-anchor: middle;
    opacity: 0;
  }

  .pl-cap-1,
  .pl-cap-2 {
    fill: var(--color-muted);
  }

  .pl-cap-3 {
    fill: var(--color-status);
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pl-scene {
      animation: pipeline-scene 10s linear infinite;
    }

    .pl-chip-0 .pl-chip-box {
      animation: pipeline-chip-0 10s linear infinite;
    }

    .pl-chip-0 .pl-tick-dot,
    .pl-chip-0 .pl-tick-mark {
      animation: pipeline-tick-0 10s ease-out infinite;
    }

    .pl-chip-1 .pl-chip-box {
      animation: pipeline-chip-1 10s linear infinite;
    }

    .pl-chip-1 .pl-tick-dot,
    .pl-chip-1 .pl-tick-mark {
      animation: pipeline-tick-1 10s ease-out infinite;
    }

    .pl-chip-2 .pl-chip-box {
      animation: pipeline-chip-2 10s linear infinite;
    }

    .pl-chip-2 .pl-tick-dot,
    .pl-chip-2 .pl-tick-mark {
      animation: pipeline-tick-2 10s ease-out infinite;
    }

    .pl-chip-3 .pl-chip-box {
      animation: pipeline-chip-3 10s linear infinite;
    }

    .pl-chip-3 .pl-tick-dot,
    .pl-chip-3 .pl-tick-mark {
      animation: pipeline-tick-3 10s ease-out infinite;
    }

    .pl-chip-4 .pl-chip-box {
      animation: pipeline-chip-4 10s linear infinite;
    }

    .pl-chip-4 .pl-tick-dot,
    .pl-chip-4 .pl-tick-mark {
      animation: pipeline-tick-4 10s ease-out infinite;
    }

    .pl-chip-5 .pl-chip-box {
      animation: pipeline-chip-5 10s linear infinite;
    }

    .pl-chip-5 .pl-tick-dot,
    .pl-chip-5 .pl-tick-mark {
      animation: pipeline-tick-5 10s ease-out infinite;
    }

    .pl-gate {
      animation: pipeline-gate 10s ease-out infinite;
    }

    .pl-ticks {
      animation: pipeline-ticks 10s linear infinite;
    }

    .pl-deploy {
      animation: pipeline-deploy 10s linear infinite;
    }

    .pl-site {
      animation: pipeline-site 10s ease-out infinite;
    }

    .pl-mark {
      animation: pipeline-mark 10s linear infinite;
    }

    .pl-h1 {
      animation: pipeline-h1 10s ease-out infinite;
    }

    .pl-h2 {
      animation: pipeline-h2 10s ease-out infinite;
    }

    .pl-sub {
      animation: pipeline-sub 10s ease-out infinite;
    }

    .pl-badge {
      animation: pipeline-badge 10s linear infinite;
    }

