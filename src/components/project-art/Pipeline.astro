      animation: pipeline-cap-2 10s linear infinite;
    }

    .pl-cap-3 {
      animation: pipeline-cap-3 10s linear infinite;
    }

    .pl-flow {
      animation: pipeline-flow 0.7s linear infinite;
    }
  }

  @keyframes pipeline-flow {
    to {
      stroke-dashoffset: -6;
    }
  }

  @keyframes pipeline-scene {
