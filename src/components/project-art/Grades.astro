---
// The Grade & Study Tracker in eight seconds: an Android app for university students. On the
// screen of a phone the courses come in one after the other, each with its grade and a bar for its
// weight (the ECTS credits of the course). With every course the average is calculated again,
// weighted by the credits (a course with more credits moves the average more), and the bar at the
// bottom shows how far the student is with the credits of the year. The numbers are real: the
// average is worked out here from the grades and the credits below, so it is always right.
//
// Pure CSS and SVG. All pictures of the project cards use the same coordinates (240 by 200) and
// the same label size, so that text looks the same size in every card. The base style of every part
// is the frame that tells the story (used with reduced motion, and before the animation starts: all
// courses are in, the average and the progress are final); the keyframes build the scene up and the
// whole scene fades out at the end of the loop. The times are in the comments (the loop is 8
// seconds, so 12.5 per cent are one second).

interface Course {
  name: string;
  /** The credits: the weight of the course */
  ects: number;
  grade: number;
}
const courses: Course[] = [
  { name: 'Algebra', ects: 8, grade: 1.7 },
  { name: 'Networks', ects: 6, grade: 2.3 },
  { name: 'Algorithms', ects: 9, grade: 1.3 },
  { name: 'Databases', ects: 6, grade: 2.0 },
  { name: 'Deep Learning', ects: 5, grade: 1.0 },
];
// The average after every course, weighted by the credits (two decimals, so that nothing depends on
// how a university rounds)
const averages = courses.map((_, index) => {
  const taken = courses.slice(0, index + 1);
  const credits = taken.reduce((sum, course) => sum + course.ects, 0);
  const points = taken.reduce((sum, course) => sum + course.ects * course.grade, 0);
  return (points / credits).toFixed(2);
});
const FIRST_ROW = 62;
const ROW_STEP = 21;
const BAR_PER_CREDIT = 3.2;
---

<svg
  viewBox="0 0 240 200"
  class="grades block h-full w-full"
  preserveAspectRatio="xMidYMid meet"
  focusable="false"
>
  <g class="gt-scene">
    <text class="gt-title" x="5" y="10">
      Grade &amp; Study Tracker
    </text>

    <!-- The phone -->
    <rect class="gt-phone" x="64" y="18" width="112" height="164" rx="14"></rect>
    <rect class="gt-notch" x="108" y="23" width="24" height="3" rx="1.5"></rect>
    <text class="gt-head" x="74" y="42">
      My Grades
    </text>

    <!-- The courses: name, a bar for the credits (the weight), the grade -->
    {courses.map((course, index) => {
      const y = FIRST_ROW + index * ROW_STEP;
      return (
        <g class={`gt-row gt-row-${String(index)}`}>
          <text class="gt-name" x="74" y={y}>
            {course.name}
          </text>
          <rect
            class="gt-weight"
            x="74"
            y={y + 3.5}
            width={course.ects * BAR_PER_CREDIT}
            height="2.5"
            rx="1.25"
          />
          <text class={`gt-grade ${course.grade <= 1.7 ? 'gt-good' : 'gt-fair'}`} x="166" y={y}>
            {course.grade.toFixed(1)}
          </text>
        </g>
      );
    })}

    <!-- The average over everything so far, and the progress of the credits -->
    <line class="gt-line" x1="74" y1="154" x2="166" y2="154"></line>
    <text class="gt-label" x="74" y="167">
      Average
    </text>
    <rect class="gt-pulse" x="140" y="158" width="28" height="12" rx="3"></rect>
    {averages.map((average, index) => (
      <text class={`gt-avg gt-avg-${String(index)}`} x="166" y="167">
        {average}
      </text>
    ))}
    <rect class="gt-track" x="74" y="172" width="92" height="3.5" rx="1.75"></rect>
    <rect class="gt-progress" x="74" y="172" width="92" height="3.5" rx="1.75"></rect>

    <!-- What is happening, in three phases -->
    <text class="gt-cap gt-cap-1" x="120" y="194">
      Grades Per Course
    </text>
    <text class="gt-cap gt-cap-2" x="120" y="194">
      Weighted by ECTS
    </text>
    <text class="gt-cap gt-cap-3" x="120" y="194">
      Average and Progress
    </text>
  </g>
</svg>

<style>
  /* Colors come from the tokens of the site */
  .gt-title {
    fill: var(--color-accent-2);
    font-family: var(--font-mono), monospace;
    font-size: 8.5px;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }

  .gt-phone {
    fill: color-mix(in srgb, var(--color-surface) 80%, transparent);
    stroke: var(--color-border);
    stroke-width: 1.4;
  }

  .gt-notch {
    fill: var(--color-border);
  }

  .gt-head,
  .gt-name,
  .gt-grade,
  .gt-label,
  .gt-avg {
    font-family: var(--font-mono), monospace;
    font-size: 8.5px;
    letter-spacing: 0.02em;
  }

  .gt-head {
    fill: var(--color-accent-2);
    opacity: 0.85;
  }

  .gt-name {
    fill: var(--color-fg);
    opacity: 0.85;
  }

  .gt-grade {
    text-anchor: end;
  }

  .gt-good {
    fill: var(--color-status);
  }

  .gt-fair {
    fill: var(--color-accent-2);
  }

  .gt-weight {
    fill: var(--color-accent);
    opacity: 0.8;
  }

  .gt-line {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .gt-label {
    fill: var(--color-muted);
  }

  .gt-avg {
    fill: var(--color-contrast);
    text-anchor: end;
    opacity: 0;
  }

  .gt-pulse {
    fill: var(--color-contrast);
    opacity: 0;
  }

  .gt-track {
    fill: var(--color-border);
  }

  .gt-progress {
    fill: var(--color-status);
    transform-box: fill-box;
    transform-origin: 0% 50%;
    transform: scaleX(0.567);
  }

  .gt-cap {
    font-family: var(--font-mono), monospace;
    font-size: 8.5px;
    letter-spacing: 0.02em;
    text-anchor: middle;
    opacity: 0;
  }

  .gt-cap-1,
  .gt-cap-2 {
    fill: var(--color-muted);
  }

  /* The frame that tells the story: all courses are in, the average and the progress are final */
  .gt-avg-4 {
    opacity: 1;
  }

  .gt-cap-3 {
    fill: var(--color-contrast);
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gt-scene {
      animation: grades-scene 8s linear infinite;
    }

    .gt-row-0 {
      animation: grades-row-0 8s ease-out infinite;
    }

    .gt-row-1 {
      animation: grades-row-1 8s ease-out infinite;
    }

    .gt-row-2 {
      animation: grades-row-2 8s ease-out infinite;
    }

    .gt-row-3 {
      animation: grades-row-3 8s ease-out infinite;
    }

    .gt-row-4 {
      animation: grades-row-4 8s ease-out infinite;
    }

    .gt-weight {
      animation: grades-weight 8s linear infinite;
    }

    .gt-avg-0 {
      animation: grades-avg-0 8s linear infinite;
    }

    .gt-avg-1 {
      animation: grades-avg-1 8s linear infinite;
    }

    .gt-avg-2 {
      animation: grades-avg-2 8s linear infinite;
    }

    .gt-avg-3 {
      animation: grades-avg-3 8s linear infinite;
    }

    .gt-avg-4 {
      animation: grades-avg-4 8s linear infinite;
    }

    .gt-pulse {
      animation: grades-pulse 8s linear infinite;
    }

    .gt-progress {
      animation: grades-progress 8s ease-in-out infinite;
    }

    .gt-cap-1 {
      animation: grades-cap-1 8s linear infinite;
    }

    .gt-cap-2 {
      animation: grades-cap-2 8s linear infinite;
    }

    .gt-cap-3 {
      animation: grades-cap-3 8s linear infinite;
    }
  }

  /* The whole scene builds up and fades out, so the loop has no visible seam */
  @keyframes grades-scene {
    0% {
      opacity: 0;
    }
    3.75%,
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* The courses come in one after the other (0.9 s, 1.45 s, 2 s, 2.55 s, 3.1 s) */
  @keyframes grades-row-0 {
    0%,
    11.25% {
      opacity: 0;
      transform: translateX(-6px);
    }
    15%,
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes grades-row-1 {
    0%,
    18.13% {
      opacity: 0;
      transform: translateX(-6px);
    }
    21.88%,
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes grades-row-2 {
    0%,
    25% {
      opacity: 0;
      transform: translateX(-6px);
    }
    28.75%,
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes grades-row-3 {
    0%,
    31.88% {
      opacity: 0;
      transform: translateX(-6px);
    }
    35.63%,
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes grades-row-4 {
    0%,
    38.75% {
      opacity: 0;
      transform: translateX(-6px);
    }
    42.5%,
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* The bars of the weights light up while the caption says that the average is weighted */
  @keyframes grades-weight {
    0%,
    32% {
      fill: var(--color-accent);
      opacity: 0.8;
    }
    36%,
    54% {
      fill: var(--color-accent-2);
      opacity: 1;
    }
    58%,
    100% {
      fill: var(--color-accent);
      opacity: 0.8;
    }
  }

  /* The average is made again with every course (the number changes at 1.1 s, 1.65 s, 2.2 s,
     2.75 s and 3.3 s, in one step) */
  @keyframes grades-avg-0 {
    0%,
    13.8% {
      opacity: 0;
    }
    14.6%,
    20.6% {
      opacity: 1;
    }
    21.5%,
    100% {
      opacity: 0;
    }
  }

  @keyframes grades-avg-1 {
    0%,
    20.6% {
      opacity: 0;
    }
    21.5%,
    27.5% {
      opacity: 1;
    }
    28.4%,
    100% {
      opacity: 0;
    }
  }

  @keyframes grades-avg-2 {
    0%,
    27.5% {
      opacity: 0;
    }
    28.4%,
    34.4% {
      opacity: 1;
    }
    35.3%,
    100% {
      opacity: 0;
    }
  }

  @keyframes grades-avg-3 {
    0%,
    34.4% {
      opacity: 0;
    }
    35.3%,
    41.3% {
      opacity: 1;
    }
    42.1%,
    100% {
      opacity: 0;
    }
  }

  @keyframes grades-avg-4 {
    0%,
    41.3% {
      opacity: 0;
    }
    42.1%,
    100% {
      opacity: 1;
    }
  }

  /* A short glow behind the number every time it changes */
  @keyframes grades-pulse {
    0% {
      opacity: 0;
    }
    13.8% {
      opacity: 0;
    }
    15% {
      opacity: 0.3;
    }
    21.3% {
      opacity: 0;
    }
    20.6% {
      opacity: 0;
    }
    21.9% {
      opacity: 0.3;
    }
    28.1% {
      opacity: 0;
    }
    27.5% {
      opacity: 0;
    }
    28.8% {
      opacity: 0.3;
    }
    35% {
      opacity: 0;
    }
    34.4% {
      opacity: 0;
    }
    35.6% {
      opacity: 0.3;
    }
    41.9% {
      opacity: 0;
    }
    41.3% {
      opacity: 0;
    }
    42.5% {
      opacity: 0.3;
    }
    48.8% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  /* The credits so far, out of 60: 8, 14, 23, 29 and 34 */
  @keyframes grades-progress {
    0%,
    11.25% {
      transform: scaleX(0);
    }
    16.25%,
    18.13% {
      transform: scaleX(0.133);
    }
    23.13%,
    25% {
      transform: scaleX(0.233);
    }
    30%,
    31.88% {
      transform: scaleX(0.383);
    }
    36.88%,
    38.75% {
      transform: scaleX(0.483);
    }
    43.75%,
    100% {
      transform: scaleX(0.567);
    }
  }

  /* The phases: grades per course (0.8 s), weighted by credits (3.1 s), average and progress (4.9 s) */
  @keyframes grades-cap-1 {
    0%,
    10% {
      opacity: 0;
    }
    12.5%,
    33.75% {
      opacity: 0.85;
    }
    35.63%,
    100% {
      opacity: 0;
    }
  }

  @keyframes grades-cap-2 {
    0%,
    35.63% {
      opacity: 0;
    }
    38.75%,
    54% {
      opacity: 0.9;
    }
    56.25%,
    100% {
      opacity: 0;
    }
  }

  @keyframes grades-cap-3 {
    0%,
    58% {
      opacity: 0;
    }
    61.25%,
    100% {
      opacity: 0.95;
    }
  }
</style>
