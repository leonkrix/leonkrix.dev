---
import GameGrid from '@/components/games/GameGrid.astro';
import Icon from '@/components/Icon.astro';
import Section from '@/components/Section.astro';
import { gamesPath, homeGames, liveGames, playgroundIntro } from '@/games/registry';

interface Props {
  /** Number shown above the title, e.g. "04" */
  index: string;
}

const { index } = Astro.props;
const games = homeGames();
const all = liveGames().length;
---

{games.length > 0 && (
  <Section id="playground" index={index} title="Playground">
    <p class="reveal max-w-2xl text-lg leading-relaxed text-muted">{playgroundIntro}</p>
    <div class="mt-10">
      <GameGrid games={games} />
    </div>
    <p class="reveal mt-8">
      <a
        href={gamesPath}
        class="btn-outline inline-flex items-center gap-2 rounded-lg px-5 py-3 text-sm font-medium text-fg"
      >
        All games ({all})
        <Icon name="lucide:arrow-right" class="size-4" />
      </a>
    </p>
  </Section>
)}
