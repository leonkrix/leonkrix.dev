# Copy this file to `.env` for local development. `.env` is gitignored.
# In production these are set as Cloudflare build variables.
# NEVER put real values in this file: the repository is public and git history is permanent.

IMPRESSUM_STREET="[Street and number]"
IMPRESSUM_ZIP="[ZIP]"
IMPRESSUM_CITY="[City]"

# Builds the contact form into the site. Leave it out to build without the form (like production does
# until the privacy policy covers it). pnpm build:form sets it for the browser tests.
# PUBLIC_CONTACT_FORM=true
